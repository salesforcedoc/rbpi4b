diff --git a/systems/fbdev/compat_shim.c b/systems/fbdev/compat_shim.c
new file mode 100644
--- /dev/null
+++ b/systems/fbdev/compat_shim.c
@@ -0,0 +1,35 @@
+/*
+ * compat_shim.c -- fstat() for a glibc 2.13 target built with modern headers.
+ *
+ * Our headers are glibc 2.36 (the target rootfs ships no /usr/include), so
+ * fstat() compiles into a reference on fstat@GLIBC_2.33; the target's libc
+ * 2.13 only ever exported __fxstat()/__fxstat64().  syscall(SYS_fstat) fills
+ * the caller's buffer exactly as glibc would -- on ARM the struct is the
+ * kernel's, passed straight through (glibc's fstat() is a tail call into
+ * fstatat() with AT_EMPTY_PATH) -- and syscall() is GLIBC_2.4.  vt.c reads
+ * sbf.st_rdev out of that struct, so "exactly as glibc would" is the whole
+ * requirement.
+ *
+ * Identical to lib/direct/compat_shim.c, which covers libdirect's own fstat()
+ * reference (stream.c) and exports the symbol for libdirectfb
+ * (src/media/idirectfbfont.c).  This copy exists so the dlopen'd fbdev module
+ * resolves its own reference without depending on load order.  Keep the two in
+ * step; see tools/build-directfb/README.md for the measurements.
+ *
+ * This is not part of upstream DirectFB 1.4.16.
+ */
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE     /* guarded: the build also passes -D_GNU_SOURCE on the
+                           command line, and an unguarded define makes the
+                           preprocessor warn "_GNU_SOURCE redefined" -- the one
+                           warning these two files would otherwise add */
+#endif
+#include <sys/stat.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+int
+fstat (int fd, struct stat *buf)
+{
+     return syscall (SYS_fstat, fd, buf);
+}
diff --git a/systems/fbdev/fbdev.c b/systems/fbdev/fbdev.c
--- a/systems/fbdev/fbdev.c
+++ b/systems/fbdev/fbdev.c
@@ -33,6 +33,7 @@
 #include <asm/types.h>    /* Needs to be included before dfb_types.h */
 
 #include <unistd.h>
+#include <sys/syscall.h>
 #include <stdio.h>
 #include <stdlib.h>
 #include <errno.h>
@@ -116,6 +117,262 @@ static int fbdev_ioctl( int request, void *arg, int ar
 
 #define FBDEV_IOCTL(request,arg)   fbdev_ioctl( request, arg, sizeof(*(arg)) )
 
+extern FBDev *dfb_fbdev;   /* defined further below */
+
+/*
+ * PRESENTATION: copy the logical layer surface into the physical framebuffer.
+ * Every mode except PRESENT_OFF comes through here; OFF copies nothing at all,
+ * because the layer surface *is* the fb page.
+ *
+ *   src   : logical surface buffer, sw x sh pixels, spitch bytes/row, sbpp Bpp
+ *   dst   : physical fb buffer, fw x fh pixels, fpitch bytes/row, dbpp Bpp
+ *   mode  : PRESENT_CONVERT / LETTERBOX / CROP / ROTATE
+ *   deg   : PRESENT_ROTATE's angle: 90 = left (CCW), 270 = right (CW), 180
+ *   dx,dy : where the surface starts inside the fb (PRESENT_LETTERBOX)
+ *
+ * The fast paths are the point on a target that presents at 60 fps: a 1280x800
+ * frame is 2 MB, so a per-pixel loop carrying a format test in it cannot do a
+ * frame every 16 ms.
+ *
+ * The scratch buffer is needed only by PRESENT_ROTATE, which rotates in place.
+ * The other modes read src and write dst directly -- and those are always two
+ * different buffers, because under every mode except OFF the layer draws into
+ * rot_surface in system memory (see fbdevLock()).
+ */
+
+static const char *
+fbdev_present_name( int mode )
+{
+     switch (mode) {
+          case PRESENT_CONVERT:   return "convert";
+          case PRESENT_LETTERBOX: return "letterbox";
+          case PRESENT_CROP:      return "crop";
+          case PRESENT_ROTATE:    return "rotate";
+     }
+
+     return "off";
+}
+/* convert RGB565 -> RGB32 (single pixel) */
+static inline unsigned int
+rgb565_to_rgb32( unsigned int px )
+{
+     unsigned int r = (px >> 11) & 0x1f;
+     unsigned int g = (px >> 5)  & 0x3f;
+     unsigned int b = px & 0x1f;
+     r = (r << 3) | (r >> 2);
+     g = (g << 2) | (g >> 4);
+     b = (b << 3) | (b >> 2);
+     return 0xff000000 | (r << 16) | (g << 8) | b;
+}
+
+/* convert RGB32 -> RGB565 (single pixel): the inverse of the above */
+static inline unsigned short
+rgb32_to_rgb565( unsigned int px )
+{
+     unsigned int r = (px >> 19) & 0x1f;
+     unsigned int g = (px >> 10) & 0x3f;
+     unsigned int b = (px >> 3)  & 0x1f;
+
+     return (unsigned short)((r << 11) | (g << 5) | b);
+}
+
+/* fill one row span [x0,x1) with black, in the fb's own pixel format */
+static void
+fbdev_fill_span( unsigned char *row, int x0, int x1, int dbpp )
+{
+     if (dbpp == 2) {
+          unsigned short *p = (unsigned short *)row + x0;
+
+          while (x0++ < x1)
+               *p++ = 0;                                   /* RGB565 black */
+     }
+     else {
+          unsigned int *p = (unsigned int *)row + x0;
+
+          while (x0++ < x1)
+               *p++ = 0xff000000;                          /* XRGB8888 black */
+     }
+}
+
+/*
+ * PRESENT_LETTERBOX: fill the bars around a sw x sh surface at (dx,dy) in an
+ * fw x fh fb.  Only the bars are written -- clearing the whole fb first would
+ * be a full-frame memset on top of the copy, for the same result.
+ */
+static void
+fbdev_fill_bars( unsigned char *dst, int fw, int fh, int fpitch, int dbpp,
+                 int dx, int dy, int sw, int sh )
+{
+     int y;
+
+     for (y = 0; y < dy && y < fh; y++)                     /* above the surface */
+          fbdev_fill_span( dst + y * fpitch, 0, fw, dbpp );
+
+     for (; y < dy + sh && y < fh; y++) {                   /* beside it */
+          unsigned char *row = dst + y * fpitch;
+
+          fbdev_fill_span( row, 0, dx, dbpp );
+          fbdev_fill_span( row, dx + sw, fw, dbpp );
+     }
+
+     for (; y < fh; y++)                                    /* below it */
+          fbdev_fill_span( dst + y * fpitch, 0, fw, dbpp );
+}
+
+/*
+ * PRESENT_ROTATE (Prime GO): the portrait-panel path.  The loops below are the
+ * original ones, unchanged -- the generalization was to the modes around them,
+ * not to the angle arithmetic.  They write 32bpp pixels unconditionally, which
+ * is why fbdev's init refuses ROTATE on a fb that is not 32bpp.
+ *
+ * The process-global scratch buffer makes the in-place rotation safe.
+ */
+static void
+fbdev_rotate_rows( unsigned char *src, int sw, int sh, int spitch,
+                   unsigned char *dst, int fw, int fh, int fpitch,
+                   int deg, int src_bpp )
+{
+     FBDevShared   *shared  = dfb_fbdev->shared;
+     unsigned char *scratch = shared->rot_scratch;
+     unsigned int   x, y;
+
+     if (!scratch || !src || !dst)
+          return;
+
+     /* copy the whole logical buffer to scratch first (safe in-place) */
+     memcpy( scratch, src, (size_t)sh * spitch );
+
+     if (src_bpp == 2) {
+          /* RGB16 source -> RGB32 fb: convert while rotating */
+          for (y = 0; y < (unsigned)sh; y++) {
+               const unsigned short *srow = (const unsigned short *)(scratch + y * spitch);
+               for (x = 0; x < (unsigned)sw; x++) {
+                    unsigned int *dp;
+                    unsigned int  px = rgb565_to_rgb32( srow[x] );
+                    switch (deg) {
+                    case 90:
+                         dp = (unsigned int *)(dst + (sw - 1 - x) * fpitch + y * 4);
+                         break;
+                    case 270:
+                         dp = (unsigned int *)(dst + x * fpitch + (fw - 1 - y) * 4);
+                         break;
+                    case 180:
+                         dp = (unsigned int *)(dst + (sh - 1 - y) * fpitch + (sw - 1 - x) * 4);
+                         break;
+                    default:
+                         dp = (unsigned int *)(dst + y * fpitch + x * 4);
+                         break;
+                    }
+                    dp[0] = px;
+               }
+          }
+          return;
+     }
+
+     switch (deg) {
+     case 90: /* left / counter-clockwise: dst(y, sw-1-x) = src(x,y) */
+          for (y = 0; y < (unsigned)sh; y++) {
+               const unsigned int *srow = (const unsigned int *)(scratch + y * spitch);
+               for (x = 0; x < (unsigned)sw; x++) {
+                    unsigned int *dp = (unsigned int *)(dst + (sw - 1 - x) * fpitch + y * 4);
+                    dp[0] = srow[x];
+               }
+          }
+          break;
+     case 270: /* right / clockwise: dst(x, fw-1-y) = src(x,y) */
+          for (y = 0; y < (unsigned)sh; y++) {
+               const unsigned int *srow = (const unsigned int *)(scratch + y * spitch);
+               for (x = 0; x < (unsigned)sw; x++) {
+                    unsigned int *dp = (unsigned int *)(dst + x * fpitch + (fw - 1 - y) * 4);
+                    dp[0] = srow[x];
+               }
+          }
+          break;
+     case 180:
+          for (y = 0; y < (unsigned)sh; y++) {
+               const unsigned int *srow = (const unsigned int *)(scratch + y * spitch);
+               for (x = 0; x < (unsigned)sw; x++) {
+                    unsigned int *dp = (unsigned int *)(dst + (sh - 1 - y) * fpitch + (sw - 1 - x) * 4);
+                    dp[0] = srow[x];
+               }
