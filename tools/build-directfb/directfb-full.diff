diff --git a/systems/fbdev/compat_shim.c b/systems/fbdev/compat_shim.c
new file mode 100644
--- /dev/null
+++ b/systems/fbdev/compat_shim.c
@@ -0,0 +1,35 @@
+/*
+ * compat_shim.c -- fstat() for a glibc 2.13 target built with modern headers.
+ *
+ * Our headers are glibc 2.36 (the target rootfs ships no /usr/include), so
+ * fstat() compiles into a reference on fstat@GLIBC_2.33; the target's libc
+ * 2.13 only ever exported __fxstat()/__fxstat64().  syscall(SYS_fstat) fills
+ * the caller's buffer exactly as glibc would -- on ARM the struct is the
+ * kernel's, passed straight through (glibc's fstat() is a tail call into
+ * fstatat() with AT_EMPTY_PATH) -- and syscall() is GLIBC_2.4.  vt.c reads
+ * sbf.st_rdev out of that struct, so "exactly as glibc would" is the whole
+ * requirement.
+ *
+ * Identical to lib/direct/compat_shim.c, which covers libdirect's own fstat()
+ * reference (stream.c) and exports the symbol for libdirectfb
+ * (src/media/idirectfbfont.c).  This copy exists so the dlopen'd fbdev module
+ * resolves its own reference without depending on load order.  Keep the two in
+ * step; see tools/build-directfb/README.md for the measurements.
+ *
+ * This is not part of upstream DirectFB 1.4.16.
+ */
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE     /* guarded: the build also passes -D_GNU_SOURCE on the
+                           command line, and an unguarded define makes the
+                           preprocessor warn "_GNU_SOURCE redefined" -- the one
+                           warning these two files would otherwise add */
+#endif
+#include <sys/stat.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+int
+fstat (int fd, struct stat *buf)
+{
+     return syscall (SYS_fstat, fd, buf);
+}
diff --git a/systems/fbdev/fbdev.c b/systems/fbdev/fbdev.c
--- a/systems/fbdev/fbdev.c
+++ b/systems/fbdev/fbdev.c
@@ -33,6 +33,7 @@
 #include <asm/types.h>    /* Needs to be included before dfb_types.h */
 
 #include <unistd.h>
+#include <sys/syscall.h>
 #include <stdio.h>
 #include <stdlib.h>
 #include <errno.h>
@@ -83,6 +84,12 @@
 #include <direct/signals.h>
 #include <direct/system.h>
 #include <direct/util.h>
+#include <direct/clock.h>       /* direct_clock_get_micros(): the frame-budget
+                                   measurement.  Deliberately NOT clock_gettime --
+                                   on this glibc that lives in librt, nothing
+                                   else in the DirectFB tree references it, and a
+                                   first reference would be a link-time surprise
+                                   inside the chroot. */
 
 #include <misc/conf.h>
 #include <misc/util.h>
@@ -115,7 +122,458 @@ static int fbdev_ioctl( int request, void *arg, int ar
 static int fbdev_ioctl( int request, void *arg, int arg_size );
 
 #define FBDEV_IOCTL(request,arg)   fbdev_ioctl( request, arg, sizeof(*(arg)) )
+
+extern FBDev *dfb_fbdev;   /* defined further below */
+
+/* The one-shot frame-budget line.  The first presents of a run carry rbp's own
+ * bring-up rather than the blit this measures, so the line reports the average
+ * AFTER PRESENT_WARMUP and is emitted at PRESENT_REPORT_AT.  Both measured on
+ * the unit: whole-window averages ran up to ~2 ms above the warm ones, and at
+ * skip > 1 the equality-based one-shot fired eight times (present_done stalls
+ * at the trigger between presents).  See FBDevShared's present_* comment. */
+#define PRESENT_WARMUP     60
+#define PRESENT_REPORT_AT  300
+
+/*
+ * PRESENTATION: copy the logical layer surface into the physical framebuffer.
+ * Every mode except PRESENT_OFF comes through here; OFF copies nothing at all,
+ * because the layer surface *is* the fb page.
+ *
+ *   src   : logical surface buffer, sw x sh pixels, spitch bytes/row, sbpp Bpp
+ *   dst   : physical fb buffer, fw x fh pixels, fpitch bytes/row, dbpp Bpp
+ *   mode  : PRESENT_CONVERT / LETTERBOX / CROP / ROTATE
+ *   deg   : PRESENT_ROTATE's angle: 90 = left (CCW), 270 = right (CW), 180
+ *   dx,dy : where the surface starts inside the fb (PRESENT_LETTERBOX)
+ *
+ * The fast paths are the point on a target that presents at 60 fps: a 1280x800
+ * frame is 2 MB, so a per-pixel loop carrying a format test in it cannot do a
+ * frame every 16 ms.
+ *
+ * The scratch buffer is needed only by PRESENT_ROTATE, which rotates in place.
+ * The other modes read src and write dst directly -- and those are always two
+ * different buffers, because under every mode except OFF the layer draws into
+ * rot_surface in system memory (see fbdevLock()).
+ */
+
+static const char *
+fbdev_present_name( int mode )
+{
+     switch (mode) {
+          case PRESENT_CONVERT:   return "convert";
+          case PRESENT_LETTERBOX: return "letterbox";
+          case PRESENT_CROP:      return "crop";
+          case PRESENT_SCALE:     return "scale";
+          case PRESENT_ROTATE:    return "rotate";
+     }
+
+     return "off";
+}
+
+/* convert RGB565 -> RGB32 (single pixel) */
+static inline unsigned int
+rgb565_to_rgb32( unsigned int px )
+{
+     unsigned int r = (px >> 11) & 0x1f;
+     unsigned int g = (px >> 5)  & 0x3f;
+     unsigned int b = px & 0x1f;
+     r = (r << 3) | (r >> 2);
+     g = (g << 2) | (g >> 4);
+     b = (b << 3) | (b >> 2);
+     return 0xff000000 | (r << 16) | (g << 8) | b;
+}
+
+/* convert RGB32 -> RGB565 (single pixel): the inverse of the above */
+static inline unsigned short
+rgb32_to_rgb565( unsigned int px )
+{
+     unsigned int r = (px >> 19) & 0x1f;
+     unsigned int g = (px >> 10) & 0x3f;
+     unsigned int b = (px >> 3)  & 0x1f;
+
+     return (unsigned short)((r << 11) | (g << 5) | b);
+}
+
+/*
+ * Where a sw x sh surface lands in an fw x fh fb.
+ *
+ * ONE helper, called by both the blit and the one-shot PRESENT: line, so the
+ * logged rectangle and the drawn one cannot disagree.
+ *
+ * Aspect-fit unless `stretch`, in which case both axes are filled.  Returns the
+ * destination size in *dw and *dh and its top-left in *dx and *dy, centred.
+ *
+ * The scale factor is 16.16 and the STEP is floored, which is what bounds the
+ * rectangle: s <= (fw << 16) / sw and s <= (fh << 16) / sh, so sw * s <= fw << 16
+ * and sh * s <= fh << 16 hold, and *dw <= fw / *dh <= fh therefore hold for any
+ * final rounding that adds less than 65536.  That is the invariant the old
+ * `dx + sw > fw` guard was compensating for, and it is why PRESENT_SCALE cannot
+ * hit that hole by construction.
+ *
+ * The final shift ROUNDS TO NEAREST (+32768), not down, and the difference is
+ * measurable rather than cosmetic: the step is already floored, so flooring
+ * again loses a whole row AND column on every inexact fit -- 1280x720 came out
+ * 1151x719 and 1920x1080 came out 1727x1079, each leaving a one-pixel bar on two
+ * edges and none on the other two.  Nearest keeps the invariant and lands on the
+ * exact fit (1152x720, 1728x1080).
+ *
+ * point_fit() in scripts/shims/point_xform.c transcribes this for the cursor,
+ * which is an LD_PRELOAD shim in a different build, so a change to one is a
+ * change to both.
+ */
+static void
+fbdev_present_fit( int sw, int sh, int fw, int fh, int stretch,
+                   int *dw, int *dh, int *dx, int *dy )
+{
+     if (sw <= 0 || sh <= 0 || fw <= 0 || fh <= 0) {
+          *dw = *dh = *dx = *dy = 0;
+          return;
+     }
+
+     if (stretch) {
+          *dw = fw;
+          *dh = fh;
+     }
+     else {
+          unsigned long long s = ((unsigned long long)fw << 16) / (unsigned)sw;
+          unsigned long long t = ((unsigned long long)fh << 16) / (unsigned)sh;
+
+          if (t < s)
+               s = t;                             /* whichever axis binds */
+
+          *dw = (int)(((unsigned long long)sw * s + 32768) >> 16);
+          *dh = (int)(((unsigned long long)sh * s + 32768) >> 16);
+          if (*dw < 1)
+               *dw = 1;
+          if (*dh < 1)
+               *dh = 1;
+     }
+
+     *dx = (fw - *dw) / 2;
+     *dy = (fh - *dh) / 2;
+}
+
+/*
+ * PRESENT_SCALE: nearest-neighbour resample of the sw x sh logical surface into
+ * the dw x dh rectangle at (dx,dy) of the physical fb.
+ *
+ * One output pixel is one accumulator add, one shift, one source load and one
+ * destination store; ARM's scaled-index addressing folds the <<1 of the 16-bit
+ * cases into the load, so the inner loop is lsr / ldrh / strh / add / cmp.
+ *
+ * The row index is hoisted out of the x loop, and a DOWNSCALE revisits the same
+ * source row for several output rows -- which is why the source rows stay hot in
+ * L1/L2 across the repeat.
+ *
+ * Both accumulators start at half a step, so a sample lands at the CENTRE of the
+ * destination pixel's footprint instead of at its left/top edge.  Half a pixel
+ * of bias is the difference between ragged and acceptable bitmap text on a
+ * downscale.
+ *
+ * stepx is the FLOOR of sw<<16/dw, which is what guarantees the index can never
+ * reach sw even with the half-step offset:
+ *     (dw - 1/2) * floor((sw<<16)/dw)  <  (dw - 1/2) * (sw<<16)/dw  <  sw<<16
+ * so there is no clamp in the inner loop and none is needed.
+ */
+static void
+fbdev_present_scale( const unsigned char *src, int sw, int sh, int spitch, int sbpp,
+                     unsigned char *dst, int fpitch, int dbpp,
+                     int dx, int dy, int dw, int dh )
+{
+     unsigned int stepx = (unsigned int)(((unsigned long long)sw << 16) / (unsigned)dw);
+     unsigned int stepy = (unsigned int)(((unsigned long long)sh << 16) / (unsigned)dh);
+     unsigned int accy  = stepy >> 1;
+     int          y;
+
+     for (y = 0; y < dh; y++) {
+          const unsigned char *srow = src + (size_t)(accy >> 16) * spitch;
+          unsigned char       *drow = dst + (size_t)(y + dy) * fpitch + (size_t)dx * dbpp;
+          unsigned int         acc  = stepx >> 1;
+          int                  x;
+
+          switch ((sbpp << 2) | dbpp) {
+          case (2 << 2) | 2: {                    /* 565 -> 565: the Pi's case */
+               const unsigned short *s = (const unsigned short *)srow;
+               unsigned short       *d = (unsigned short *)drow;
+
+               for (x = 0; x < dw; x++) {
+                    *d++ = s[acc >> 16];
+                    acc += stepx;
+               }
+               break;
+          }
+          case (2 << 2) | 4: {                    /* 565 -> 8888: the expensive one */
+               const unsigned short *s = (const unsigned short *)srow;
+               unsigned int         *d = (unsigned int *)drow;
+
+               for (x = 0; x < dw; x++) {
+                    *d++ = rgb565_to_rgb32( s[acc >> 16] );
+                    acc += stepx;
+               }
+               break;
+          }
+          case (4 << 2) | 2: {
+               const unsigned int *s = (const unsigned int *)srow;
+               unsigned short     *d = (unsigned short *)drow;
+
+               for (x = 0; x < dw; x++) {
+                    *d++ = rgb32_to_rgb565( s[acc >> 16] );
+                    acc += stepx;
+               }
+               break;
+          }
+          case (4 << 2) | 4: {
+               const unsigned int *s = (const unsigned int *)srow;
+               unsigned int       *d = (unsigned int *)drow;
+
+               for (x = 0; x < dw; x++) {
+                    *d++ = s[acc >> 16];
+                    acc += stepx;
+               }
+               break;
+          }
+          default:
+               return;                             /* no conversion for this pair */
+          }
+
+          accy += stepy;
+     }
+}
+/* fill one row span [x0,x1) with black, in the fb's own pixel format */
+static void
+fbdev_fill_span( unsigned char *row, int x0, int x1, int dbpp )
+{
+     if (dbpp == 2) {
+          unsigned short *p = (unsigned short *)row + x0;
+
+          while (x0++ < x1)
+               *p++ = 0;                                   /* RGB565 black */
+     }
+     else {
+          unsigned int *p = (unsigned int *)row + x0;
+
+          while (x0++ < x1)
+               *p++ = 0xff000000;                          /* XRGB8888 black */
+     }
+}
+
+/*
+ * PRESENT_LETTERBOX: fill the bars around a sw x sh surface at (dx,dy) in an
+ * fw x fh fb.  Only the bars are written -- clearing the whole fb first would
+ * be a full-frame memset on top of the copy, for the same result.
+ */
+static void
+fbdev_fill_bars( unsigned char *dst, int fw, int fh, int fpitch, int dbpp,
+                 int dx, int dy, int sw, int sh )
+{
+     int y;
+
+     for (y = 0; y < dy && y < fh; y++)                     /* above the surface */
+          fbdev_fill_span( dst + y * fpitch, 0, fw, dbpp );
+
+     for (; y < dy + sh && y < fh; y++) {                   /* beside it */
+          unsigned char *row = dst + y * fpitch;
+
+          fbdev_fill_span( row, 0, dx, dbpp );
+          fbdev_fill_span( row, dx + sw, fw, dbpp );
+     }
+
+     for (; y < fh; y++)                                    /* below it */
+          fbdev_fill_span( dst + y * fpitch, 0, fw, dbpp );
+}
+
+/*
+ * PRESENT_ROTATE (Prime GO): the portrait-panel path.  The loops below are the
+ * original ones, unchanged -- the generalization was to the modes around them,
+ * not to the angle arithmetic.  They write 32bpp pixels unconditionally, which
+ * is why fbdev's init refuses ROTATE on a fb that is not 32bpp.
+ *
+ * The process-global scratch buffer makes the in-place rotation safe.
+ */
+static void
+fbdev_rotate_rows( unsigned char *src, int sw, int sh, int spitch,
+                   unsigned char *dst, int fw, int fh, int fpitch,
+                   int deg, int src_bpp )
+{
+     FBDevShared   *shared  = dfb_fbdev->shared;
+     unsigned char *scratch = shared->rot_scratch;
+     unsigned int   x, y;
+
+     if (!scratch || !src || !dst)
+          return;
+
+     /* copy the whole logical buffer to scratch first (safe in-place) */
+     memcpy( scratch, src, (size_t)sh * spitch );
+
+     if (src_bpp == 2) {
+          /* RGB16 source -> RGB32 fb: convert while rotating */
+          for (y = 0; y < (unsigned)sh; y++) {
+               const unsigned short *srow = (const unsigned short *)(scratch + y * spitch);
+               for (x = 0; x < (unsigned)sw; x++) {
+                    unsigned int *dp;
+                    unsigned int  px = rgb565_to_rgb32( srow[x] );
+                    switch (deg) {
+                    case 90:
+                         dp = (unsigned int *)(dst + (sw - 1 - x) * fpitch + y * 4);
+                         break;
+                    case 270:
+                         dp = (unsigned int *)(dst + x * fpitch + (fw - 1 - y) * 4);
+                         break;
+                    case 180:
+                         dp = (unsigned int *)(dst + (sh - 1 - y) * fpitch + (sw - 1 - x) * 4);
+                         break;
+                    default:
+                         dp = (unsigned int *)(dst + y * fpitch + x * 4);
+                         break;
+                    }
+                    dp[0] = px;
+               }
+          }
+          return;
+     }
 
+     switch (deg) {
+     case 90: /* left / counter-clockwise: dst(y, sw-1-x) = src(x,y) */
+          for (y = 0; y < (unsigned)sh; y++) {
+               const unsigned int *srow = (const unsigned int *)(scratch + y * spitch);
+               for (x = 0; x < (unsigned)sw; x++) {
+                    unsigned int *dp = (unsigned int *)(dst + (sw - 1 - x) * fpitch + y * 4);
+                    dp[0] = srow[x];
+               }
+          }
+          break;
+     case 270: /* right / clockwise: dst(x, fw-1-y) = src(x,y) */
+          for (y = 0; y < (unsigned)sh; y++) {
+               const unsigned int *srow = (const unsigned int *)(scratch + y * spitch);
+               for (x = 0; x < (unsigned)sw; x++) {
+                    unsigned int *dp = (unsigned int *)(dst + x * fpitch + (fw - 1 - y) * 4);
+                    dp[0] = srow[x];
+               }
+          }
+          break;
+     case 180:
+          for (y = 0; y < (unsigned)sh; y++) {
+               const unsigned int *srow = (const unsigned int *)(scratch + y * spitch);
+               for (x = 0; x < (unsigned)sw; x++) {
+                    unsigned int *dp = (unsigned int *)(dst + (sh - 1 - y) * fpitch + (sw - 1 - x) * 4);
+                    dp[0] = srow[x];
+               }
+          }
+          break;
+     default: /* no rotation: plain copy */
+          memcpy( dst, scratch, (size_t)sh * spitch );
+          break;
+     }
+}
+
+static void
+fbdev_present_primary( unsigned char *src, int sw, int sh, int spitch, int sbpp,
+                       unsigned char *dst, int fw, int fh, int fpitch, int dbpp,
+                       int mode, int deg, int dx, int dy, int dw, int dh )
+{
+     int x, y, rows, cols;
+
+     if (!src || !dst || sw <= 0 || sh <= 0 || spitch <= 0 || fw <= 0 || fh <= 0)
+          return;
+
+     if (mode == PRESENT_ROTATE) {
+          fbdev_rotate_rows( src, sw, sh, spitch, dst, fw, fh, fpitch, deg, sbpp );
+          return;
+     }
+
+     /* PRESENT_SCALE resamples into its own rectangle, which fbdev_present_fit()
+        computed at open; this only has to sanity-check it.  The fit's floor step
+        makes dx+dw <= fw and dy+dh <= fh hold by construction, so a violation is
+        a caller bug and drawing nothing is the safe answer. */
+     if (mode == PRESENT_SCALE) {
+          if (dw <= 0 || dh <= 0 || dx < 0 || dy < 0 || dx + dw > fw || dy + dh > fh)
+               return;
+
+          /* An exact fit is not a resample.  A fb of the same geometry wants the
+             1:1 path below -- one memcpy per row rather than a per-pixel walk
+             doing 1:1 arithmetic the long way -- and that is a real case, because
+             DFB_PRESENT=scale on a MATCHING fb is how you ask for the
+             system-memory back buffer without changing the geometry. */
+          if (dw == sw && dh == sh)
+               goto one_to_one;
+
+          fbdev_fill_bars( dst, fw, fh, fpitch, dbpp, dx, dy, dw, dh );
+          fbdev_present_scale( src, sw, sh, spitch, sbpp, dst, fpitch, dbpp,
+                               dx, dy, dw, dh );
+          return;
+     }
+
+one_to_one:
+     if (dx < 0 || dy < 0)
+          return;
+
+     /* How many COLUMNS to copy.  A surface WIDER than the fb used to copy
+        nothing at all, which is a black screen rather than a crop -- and CROP is
+        the mode that *means* "take what fits", so it gets a column budget to go
+        with the row budget below.  The other modes keep the refusal: for them a
+        fb narrower than the surface is a misconfiguration, and a partial image
+        would hide it. */
+     cols = sw;
+     if (dx + cols > fw) {
+          if (mode != PRESENT_CROP)
+               return;
+          cols = fw - dx;
+          if (cols <= 0)
+               return;
+     }
+
+     /* How many rows to copy.  Never more than the fb has left below dy, so a
+        surface taller than its space -- which is what PRESENT_CROP *means* -- is
+        a row budget on the copy rather than a resampling. */
+     rows = sh;
+     if (rows > fh - dy)
+          rows = fh - dy;
+     if (rows <= 0)
+          return;
+
+     if (mode == PRESENT_LETTERBOX)
+          fbdev_fill_bars( dst, fw, fh, fpitch, dbpp, dx, dy, sw, sh );
+
+     /* The whole frame in one copy: same format, no offset, strides agree.  This
+        is the case a Pi-like fb is in, and it is a single 2 MB memcpy. */
+     if (sbpp == dbpp && dx == 0 && dy == 0 && fpitch == spitch &&
+         cols == sw && rows == sh) {
+          memcpy( dst, src, (size_t)rows * spitch );
+          return;
+     }
+
+     for (y = 0; y < rows; y++) {
+          const unsigned char *srow = src + y * spitch;
+          unsigned char       *drow = dst + (y + dy) * fpitch + dx * dbpp;
+
+          if (sbpp == dbpp) {
+               memcpy( drow, srow, (size_t)cols * sbpp );
+          }
+          else if (sbpp == 2 && dbpp == 4) {
+               /* the ~1 Mpx 565 -> 8888 convert: two pixels an iteration, or it
+                  cannot do a frame every 16 ms */
+               const unsigned short *s = (const unsigned short *)srow;
+               unsigned int         *d = (unsigned int *)drow;
+               int                   n = cols & ~1;
+
+               for (x = 0; x < n; x += 2) {
+                    d[x]     = rgb565_to_rgb32( s[x] );
+                    d[x + 1] = rgb565_to_rgb32( s[x + 1] );
+               }
+               if (cols & 1)
+                    d[cols - 1] = rgb565_to_rgb32( s[cols - 1] );
+          }
+          else if (sbpp == 4 && dbpp == 2) {
+               const unsigned int *s = (const unsigned int *)srow;
+               unsigned short     *d = (unsigned short *)drow;
+
+               for (x = 0; x < cols; x++)
+                    d[x] = rgb32_to_rgb565( s[x] );
+          }
+          else
+               return;                        /* no conversion for this pixel pair */
+     }
+}
