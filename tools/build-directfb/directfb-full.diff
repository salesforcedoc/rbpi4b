+                    }
+               }
+
+               shared->rot_fw      = shared->real_var.xres;
+               shared->rot_fh      = shared->real_var.yres;
+               /* real line_length via raw syscall (shim may fake it) */
+               {
+                    struct fb_fix_screeninfo rfx;
+                    memset( &rfx, 0, sizeof(rfx) );
+                    if (syscall( SYS_ioctl, dfb_fbdev->fd, FBIOGET_FSCREENINFO, &rfx ) == 0 && rfx.line_length)
+                         shared->rot_fpitch = rfx.line_length;
+                    else
+                         shared->rot_fpitch = shared->fix.line_length;
+               }
+               { FILE*f=fopen("/tmp/dfbdig9.log","a"); if(f){fprintf(f,"ROTINIT: real_fb=%dx%d pitch=%d (orig_var=%dx%d)\n",shared->rot_fw,shared->rot_fh,shared->rot_fpitch,shared->orig_var.xres,shared->orig_var.yres); fclose(f);} }
+
+               /* logical layer geometry (shimmed): orig_var carries the
+                * logical xres/yres/bpp that rbp believes in. */
+               {
+                    int lw = shared->orig_var.xres ? shared->orig_var.xres : 1280;
+                    int lh = shared->orig_var.yres ? shared->orig_var.yres : 800;
+                    int lbpp = (shared->orig_var.bits_per_pixel / 8);
+                    if (lbpp < 2) lbpp = 4;      /* safety */
+                    shared->rot_src_bpp = lbpp;
+                    shared->rot_scratch = malloc( (size_t)lh * lw * lbpp );
+                    /* system-memory source surface: 3 buffers (triple) of the
+                     * logical layer frame - keep separate so rbp draws into
+                     * clean buffers, then we rotate into the fb. */
+                    shared->rot_surface = malloc( 3 * (size_t)lh * lw * lbpp );
+                    shared->rot_surface_size = 3 * lh * lw * lbpp;
+               }
+               if (shared->rot_scratch && shared->rot_surface)
+                    D_INFO( "FBDev/Rotate: rotation %d enabled (fb %dx%d)\n",
+                            shared->rot_deg, shared->rot_fw, shared->rot_fh );
+               else {
+                    shared->rot_deg = 0;
+                    if (shared->rot_scratch) { free(shared->rot_scratch); shared->rot_scratch = NULL; }
+                    if (shared->rot_surface) { free(shared->rot_surface); shared->rot_surface = NULL; }
+               }
+          }
+     }
+
      shared->orig_cmap_memory = SHMALLOC( pool_data, 256 * 2 * 4 );
      if (!shared->orig_cmap_memory) {
           ret = D_OOSHM();
@@ -598,6 +775,15 @@ system_initialize( CoreDFB *core, void **data )
 
