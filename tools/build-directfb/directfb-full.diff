diff --git a/lib/direct/compat_shim.c b/lib/direct/compat_shim.c
new file mode 100644
--- /dev/null
+++ b/lib/direct/compat_shim.c
@@ -0,0 +1,55 @@
+/*
+ * compat_shim.c -- fstat() for a glibc 2.13 target built with modern headers.
+ *
+ * Why this exists
+ * ---------------
+ * The build compiles against the toolchain's own glibc 2.36 headers, because
+ * the XDJ-RX3 rootfs ships no /usr/include at all.  It links against the
+ * target's libc 2.13 instead (see the -L flags and "The link search path" in
+ * tools/build-directfb/README.md), so almost every reference resolves at its
+ * GLIBC_2.4 version and loads fine in the chroot.  fstat() is the one that
+ * cannot: glibc 2.33 added a real fstat@GLIBC_2.33, and 2.13 -- like every
+ * glibc before 2.33 -- only ever exported __fxstat()/__fxstat64(), which is
+ * what its own headers emit for an fstat() call.  The reference is therefore
+ * left unresolved, and the target's loader will not satisfy it
+ * ("undefined symbol: fstat") when the call is finally reached.
+ *
+ * Why syscall() is byte-exact here
+ * --------------------------------
+ * On ARM, glibc's struct stat is the kernel's struct stat, and glibc's own
+ * fstat() does no translation: it passes the caller's buffer straight to the
+ * kernel (a tail call into fstatat() with AT_EMPTY_PATH; sys_fstat and
+ * sys_fstatat share cp_new_stat()).  So syscall(SYS_fstat, fd, buf) fills
+ * exactly the bytes glibc would have filled, st_rdev included -- which is what
+ * systems/fbdev/vt.c reads out of it.  syscall() itself is GLIBC_2.4.
+ *
+ * fcntl() needs no shim: 2.13 exports fcntl@GLIBC_2.4, and our one call site
+ * (systems/fbdev/fbdev.c, F_SETFD/FD_CLOEXEC) carries no struct, so it never
+ * reaches for fcntl64().
+ *
+ * Duplicated on purpose
+ * ---------------------
+ * systems/fbdev/compat_shim.c holds the same forward.  DirectFB calls fstat()
+ * from three files in three build units -- lib/direct/stream.c, the
+ * src/media/idirectfbfont.c in libdirectfb, and systems/fbdev/vt.c -- and this
+ * copy in libdirect fixes its own reference while exporting the symbol for
+ * libdirectfb to bind against.  The module keeps its own so that it does not
+ * depend on load order to resolve.  Keep the two files in step.
+ *
+ * This is not part of upstream DirectFB 1.4.16.
+ */
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE     /* guarded: the build also passes -D_GNU_SOURCE on the
+                           command line, and an unguarded define makes the
+                           preprocessor warn "_GNU_SOURCE redefined" -- the one
+                           warning these two files would otherwise add */
+#endif
+#include <sys/stat.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+int
+fstat (int fd, struct stat *buf)
+{
+     return syscall (SYS_fstat, fd, buf);
+}
